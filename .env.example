# AnamnezAI — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Ollama ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e4b
MEDGEMMA_MODEL=medgemma:4b

# ── GPU (0 = CPU mode, 1+ = GPU layers) ──────────────────
OLLAMA_NUM_GPU=0

# ── PostgreSQL ────────────────────────────────────────────
# Docker Compose ile kullanırken POSTGRES_HOST=postgres
# Lokal kullanımda POSTGRES_HOST=localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anamnezai
POSTGRES_USER=anamnezai
POSTGRES_PASSWORD=anamnezai_secret
# Alternatif: tek satır bağlantı string'i
# DATABASE_URL=postgresql://anamnezai:anamnezai_secret@localhost:5432/anamnezai

# ── RAG ───────────────────────────────────────────────────
RAG_ENABLED=true

# ── Security ──────────────────────────────────────────────
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string

# CORS: production'da virgülle ayrılmış domainler ver
# Örnek: ALLOWED_ORIGINS=https://anamnezai.example.com,https://app.example.com
# Geliştirme için * bırakabilirsin:
ALLOWED_ORIGINS=*

# ── Google OAuth2 (optional — leave blank to disable) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Doctor registration ───────────────────────────────────
DOCTOR_CLINIC_CODES=CLINIC2026,AYBU2026,DEMO2026

# ── Session ───────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
