# AnamnezAI — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Ollama ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e4b
MEDGEMMA_MODEL=medgemma:4b

# ── GPU (0 = CPU mode, 1+ = GPU layers) ──────────────────
OLLAMA_NUM_GPU=0

# ── Database ──────────────────────────────────────────────
DB_PATH=./backend/anamnezai.db

# ── RAG ───────────────────────────────────────────────────
RAG_ENABLED=true

# ── Security ──────────────────────────────────────────────
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string

# ── Google OAuth2 (optional — leave blank to disable) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session ───────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30

