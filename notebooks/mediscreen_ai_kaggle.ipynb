    "    \"print(  \\\"║         Gemma 4 tarafından üretildi (gemma4:e4b via Ollama)     ║\\\")\\n\",\n",
    "    \"print(  \\\"╠══════════════════════════════════════════════════════════════════╣\\\")\\n\",\n",
    "    \"print(  f\\\"║  {'SIRA':<4} {'HASTA':<22} {'YAŞ':<5} {'CİNS':<8} {'TRİAJ':<15} {'AI %':<6}║\\\")\\n\",\n",
    "    \"print(  \\\"╠══════════════════════════════════════════════════════════════════╣\\\")\\n\",\n",
    "    \"\\n\",\n",
