    "    \"    counts[level] = counts.get(level, 0) + 1\\n\",\n",
    "    \"    print(f\\\"║  {i:<4} {p['name']:<22} {p['age']:<5} {p['gender']:<8} {label:<15} %{score:<5}║\\\")\\n\",\n",
