    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Triaj önceliğine göre sırala: RED > YELLOW > GREEN\\n\",\n",
    "    \"priority = {\\\"RED\\\": 0, \\\"YELLOW\\\": 1, \\\"GREEN\\\": 2}\\n\",\n",
    "    \"patients_queue.sort(key=lambda x: priority.get(x[\\\"summary\\\"].get(\\\"triage_level\\\", \\\"GREEN\\\"), 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"╔══════════════════════════════════════════════════════════╗\\\")\\n\",\n",
    "    \"print(\\\"║          🏥 MediScreen AI — DOKTOR KUYRUĞU              ║\\\")\\n\",\n",
    "    \"print(\\\"╠══════════════════════════════════════════════════════════╣\\\")\\n\",\n",
    "    \"print(f\\\"║  {'SIRA':<4} {'HASTA':<20} {'YAŞ':<5} {'TRİAJ':<10} {'AI SKORU':<10}║\\\")\\n\",\n",
    "    \"print(\\\"╠══════════════════════════════════════════════════════════╣\\\")\\n\",\n",
    "    \"\\n\",\n",
