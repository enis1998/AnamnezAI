    "    \"PRIORITY = {\\\"RED\\\": 0, \\\"YELLOW\\\": 1, \\\"GREEN\\\": 2}\\n\",\n",
    "    \"patient_queue = [{\\\"patient\\\": p, \\\"summary\\\": s} for p, s in results]\\n\",\n",
