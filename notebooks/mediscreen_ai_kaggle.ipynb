    "    \"    print(\\\"🧠  Gemma 4 klinik özet üretiyor...\\\")\\n\",\n",
    "    \"    summary, latency = ai_engine.generate_clinical_summary(patient, qa_history)\\n\",\n",
    "    \"    level = summary.get(\\\"triage_level\\\", \\\"YELLOW\\\")\\n\",\n",
