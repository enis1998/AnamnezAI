    "    \"    print(f\\\"\\\\n📋  KLİNİK ÖZET RAPORU [{latency:.1f}sn]:\\\")\\n\",\n",
    "    \"    print(f\\\"  {emoji} TRİAJ SEVİYESİ : {level} ({TRIAGE_TR.get(level, '')}) {match}\\\")\\n\",\n",
    "    \"    print(f\\\"  🎯 AI GÜVEN SKORU : %{summary.get('confidence_score')}\\\")\\n\",\n",
