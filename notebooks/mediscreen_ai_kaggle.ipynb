    "    \"# ─── Dinamik Mülakat — Gemma 4 soruları kendisi üretiyor ───\\n\",\n",
    "    \"\\n\",\n",
    "    \"def run_demo_interview(ai_engine, patient: dict, initial_complaint: str, num_questions: int = 4):\\n\",\n",
    "    \"    \\\"\\\"\\\"Gemma 4'ün dinamik olarak soru ürettiğini göstermek için demo mülakat.\\\"\\\"\\\"\\n\",\n",
    "    \"    print(f\\\"\\\\n{'='*60}\\\")\\n\",\n",
    "    \"    print(f\\\"🎙️  DİNAMİK MÜLAKAT DEMO — {patient['name']}\\\")\\n\",\n",
    "    \"    print(f\\\"{'='*60}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    qa_history = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # İlk soru her zaman sabit\\n\",\n",
    "    \"    first_q = f\\\"Merhaba {patient['name'].split()[0]}! Bugün sizi en çok rahatsız eden şikayetiniz nedir?\\\"\\n\",\n",
    "    \"    qa_history.append({\\\"question\\\": first_q, \\\"answer\\\": initial_complaint})\\n\",\n",
    "    \"    print(f\\\"\\\\n  🤖 Q1: {first_q}\\\")\\n\",\n",
    "    \"    print(f\\\"  👤 A1: {initial_complaint}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Gemma 4 sonraki soruları dinamik üretiyor\\n\",\n",
    "    \"    mock_answers = [\\n\",\n",
    "    \"        \\\"Yaklaşık 2 saattir devam ediyor.\\\",\\n\",\n",
    "    \"        \\\"Evet, hafif ateş de var, 37.8°C.\\\",\\n\",\n",
    "    \"        \\\"Hayır, nefes darlığı yok.\\\",\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(min(num_questions, len(mock_answers))):\\n\",\n",
    "    \"        next_q = ai_engine.generate_next_question(patient, qa_history)\\n\",\n",
    "    \"        answer = mock_answers[i]\\n\",\n",
    "    \"        qa_history.append({\\\"question\\\": next_q, \\\"answer\\\": answer})\\n\",\n",
    "    \"        print(f\\\"\\\\n  🤖 Q{i+2} [Gemma 4 üretti]: {next_q}\\\")\\n\",\n",
    "    \"        print(f\\\"  👤 A{i+2}: {answer}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\n{'─'*60}\\\")\\n\",\n",
    "    \"    print(\\\"🧠 Klinik özet üretiliyor...\\\")\\n\",\n",
    "    \"    summary = ai_engine.generate_clinical_summary(patient, qa_history)\\n\",\n",
    "    \"    emoji = TRIAGE_EMOJI.get(summary.get(\\\"triage_level\\\", \\\"YELLOW\\\"), \\\"🟡\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"  {emoji} TRİAJ: {summary.get('triage_level')} — AI Skoru: %{summary.get('confidence_score')}\\\")\\n\",\n",
    "    \"    print(f\\\"  📌 {summary.get('chief_complaint')}\\\")\\n\",\n",
    "    \"    print(f\\\"  ✅ {summary.get('recommended_action')}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return summary\\n\",\n",
