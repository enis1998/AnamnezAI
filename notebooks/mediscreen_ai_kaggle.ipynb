    "    \"    print(f\\\"  {TRIAGE_EMOJI.get(level,'?')} {p['name']:<18} [{bar}] %{score}\\\")\\n\",\n",
    "    \"print(\\\"─\\\" * 55)\"\n",
    "   ]\n",
