    "    \"    demo_patient,\\n\",\n",
    "    \"    initial_complaint=\\\"Sabahtan beri başım çok ağrıyor ve gözlerim kararıyor.\\\"\\n\",\n",
    "    \")\"\n",
    "   ]\n",
