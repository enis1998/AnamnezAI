    "   \"source\": \"# Verify the running AnamnezAI system\\nimport httpx\\n\\ndef check_anamnezai():\\n    checks = {}\\n    \\n    # 1. Offline proof\\n    try:\\n        with httpx.Client(timeout=5.0) as c:\\n            r = c.get(f\\\"{ANAMNEZAI_URL}/api/offline-proof\\\")\\n            d = r.json()\\n            checks[\\\"offline_proof\\\"] = {\\n                \\\"status\\\": \\\"OK\\\" if r.status_code == 200 else \\\"FAIL\\\",\\n                \\\"cloud_api_required\\\": d.get(\\\"cloud_api_keys_required\\\"),\\n                \\\"ollama_running\\\": d.get(\\\"ollama_running\\\"),\\n            }\\n    except Exception as e:\\n        checks[\\\"offline_proof\\\"] = {\\\"status\\\": \\\"UNREACHABLE\\\", \\\"error\\\": str(e)}\\n\\n    # 2. Health check\\n    try:\\n        with httpx.Client(timeout=5.0) as c:\\n            r = c.get(f\\\"{ANAMNEZAI_URL}/health\\\")\\n            d = r.json()\\n            checks[\\\"health\\\"] = {\\n                \\\"status\\\": \\\"OK\\\" if r.status_code == 200 else \\\"FAIL\\\",\\n                \\\"gemma4_available\\\": d.get(\\\"gemma_available\\\"),\\n                \\\"rag_chunks\\\": d.get(\\\"rag_chunks\\\"),\\n                \\\"model\\\": d.get(\\\"gemma_model\\\"),\\n            }\\n    except Exception as e:\\n        checks[\\\"health\\\"] = {\\\"status\\\": \\\"UNREACHABLE\\\", \\\"error\\\": str(e)}\\n\\n    # 3. RAG status\\n    try:\\n        with httpx.Client(timeout=5.0) as c:\\n            r = c.get(f\\\"{ANAMNEZAI_URL}/api/rag/status\\\")\\n            d = r.json()\\n            checks[\\\"rag\\\"] = {\\n                \\\"status\\\": \\\"OK\\\" if d.get(\\\"enabled\\\") else \\\"DISABLED\\\",\\n                \\\"total_chunks\\\": d.get(\\\"total_chunks\\\"),\\n                \\\"initialized\\\": d.get(\\\"initialized\\\"),\\n            }\\n    except Exception as e:\\n        checks[\\\"rag\\\"] = {\\\"status\\\": \\\"UNREACHABLE\\\", \\\"error\\\": str(e)}\\n\\n    return checks\\n\\n\\nprint(\\\"\\\\n=== AnamnezAI System Verification ===\\\")\\nresult = check_anamnezai()\\nfor endpoint, info in result.items():\\n    status = info.pop(\\\"status\\\", \\\"?\\\")\\n    icon = \\\"✅\\\" if status == \\\"OK\\\" else \\\"⚠️ \\\"\\n    detail = \\\" | \\\".join(f\\\"{k}: {v}\\\" for k, v in info.items())\\n    print(f\\\"  {icon} {endpoint:<18} {status:<12} {detail}\\\")\\n\"\n",
