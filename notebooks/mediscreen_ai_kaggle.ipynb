    "    \"                    \\\"symptoms_summary\\\": \\\"Birkaç günden beri hafif baş ağrısı, kuru öksürük ve hafif ateş (37.3°C). Genel durum iyi.\\\",\\n\",\n",
    "    \"                    \\\"possible_conditions\\\": [\\\"Üst Solunum Yolu Enfeksiyonu\\\", \\\"Viral Rinit\\\", \\\"Baş ağrısı sendromu\\\"],\\n\",\n",
    "    \"                    \\\"recommended_action\\\": \\\"Semptomatik tedavi, istirahat, bol sıvı alımı\\\",\\n\",\n",
    "    \"                    \\\"clinical_notes\\\": \\\"Vital bulgular stabil. Acil müdahale gerektirmez.\\\",\\n\",\n",
    "    \"                    \\\"urgency_flags\\\": []\\n\",\n",
    "    \"                })\\n\",\n",
    "    \"        if \\\"göğüs\\\" in p:\\n\",\n",
    "    \"            return \\\"Bu ağrı sol kolunuza ya da çenenize yayılıyor mu?\\\"\\n\",\n",
    "    \"        elif \\\"ateş\\\" in p:\\n\",\n",
    "    \"            return \\\"Ateşiniz kaç derece ve ne zamandan beri devam ediyor?\\\"\\n\",\n",
    "    \"        return \\\"Bu şikayet ne zamandan beri devam ediyor ve şiddetini 1-10 arasında nasıl değerlendirirsiniz?\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def generate_next_question(self, patient: dict, qa_history: list) -> tuple:\\n\",\n",
    "    \"        history_text = \\\"\\\\n\\\".join(\\n\",\n",
    "    \"            f\\\"S{i+1}: {qa['question']}\\\\nC{i+1}: {qa['answer']}\\\"\\n\",\n",
    "    \"            for i, qa in enumerate(qa_history) if qa.get(\\\"answer\\\")\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        prompt = (\\n\",\n",
    "    \"            f\\\"Hasta: {patient['name']}, {patient['age']} yaşında, {patient['gender']}.\\\\n\\\\n\\\"\\n\",\n",
    "    \"            f\\\"Mülakat geçmişi:\\\\n{history_text}\\\\n\\\\n\\\"\\n\",\n",
    "    \"            f\\\"Yukarıdaki cevaplara dayanarak tanıyı netleştirecek SONRAKI en kritik soruyu sor.\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        return self._query(prompt, SYSTEM_PROMPT_TR)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def generate_clinical_summary(self, patient: dict, qa_history: list) -> tuple:\\n\",\n",
    "    \"        history_text = \\\"\\\\n\\\".join(\\n\",\n",
    "    \"            f\\\"Q{i+1}: {qa['question']}\\\\nA: {qa.get('answer', '')}\\\"\\n\",\n",
    "    \"            for i, qa in enumerate(qa_history)\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        prompt = (\\n\",\n",
    "    \"            f\\\"HASTA: {patient['name']}, {patient['age']} yaş, {patient['gender']}\\\\n\\\\n\\\"\\n\",\n",
    "    \"            f\\\"5 TURLU MÜLAKAT:\\\\n{history_text}\\\\n\\\\nBu hastayı triaj et. Sadece JSON döndür.\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        raw, latency = self._query(prompt, TRIAGE_SYSTEM_TR)\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            cleaned = raw.strip()\\n\",\n",
    "    \"            if \\\"```\\\" in cleaned:\\n\",\n",
    "    \"                for part in cleaned.split(\\\"```\\\"):\\n\",\n",
    "    \"                    if \\\"{\\\" in part:\\n\",\n",
    "    \"                        cleaned = part.replace(\\\"json\\\", \\\"\\\", 1).strip()\\n\",\n",
    "    \"                        break\\n\",\n",
    "    \"            start = cleaned.find(\\\"{\\\")\\n\",\n",
    "    \"            end = cleaned.rfind(\\\"}\\\") + 1\\n\",\n",
    "    \"            return json.loads(cleaned[start:end]), latency\\n\",\n",
    "    \"        except Exception:\\n\",\n",
    "    \"            return json.loads(self._mock_response(\\\"triaj \\\" + history_text[:200])), latency\\n\",\n",
    "    \"\\n\",\n",
    "    \"    def get_performance_stats(self) -> dict:\\n\",\n",
    "    \"        if not self._latencies:\\n\",\n",
    "    \"            return {}\\n\",\n",
    "    \"        return {\\n\",\n",
    "    \"            \\\"toplam_istek\\\": len(self._latencies),\\n\",\n",
    "    \"            \\\"ortalama_latency_sn\\\": round(sum(self._latencies) / len(self._latencies), 2),\\n\",\n",
    "    \"            \\\"min_latency_sn\\\": round(min(self._latencies), 2),\\n\",\n",
    "    \"            \\\"max_latency_sn\\\": round(max(self._latencies), 2),\\n\",\n",
    "    \"            \\\"toplam_sure_sn\\\": round(sum(self._latencies), 2),\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Motor başlat\\n\",\n",
    "    \"ai = AnamnezAI(use_ollama=OLLAMA_AVAILABLE)\\n\",\n",
    "    \"print(f\\\"✅ AnamnezAI motoru başlatıldı\\\")\\n\",\n",
    "    \"print(f\\\"   Mod  : {'🟢 Gemma 4 via Ollama (Yerel)' if ai.use_ollama else '🟡 Demo Mock / HuggingFace'}\\\")\\n\",\n",
    "    \"print(f\\\"   Model: {ai.model}\\\")\"\n",
    "   ]\n",
