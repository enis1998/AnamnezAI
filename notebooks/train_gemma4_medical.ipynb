    "    \"\\n\",\n",
    "    \"# --- Test 2: Baş ağrısı (YELLOW beklenen) ---\\n\",\n",
    "    \"print('TEST 2 — Baş Ağrısı + Ateş (YELLOW bekleniyor):')\\n\",\n",
    "    \"resp = test_anamnez('Zeynep Kaya, 34y, Female', 'Q1: Symptom? A1: Severe headache and fever 38.8C for 2 days.')\\n\",\n",
    "    \"print(f'Model: {resp}\\\\n')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Test 3: Hafif şikayet (GREEN beklenen) ---\\n\",\n",
    "    \"print('TEST 3 — Hafif Şikayet (GREEN bekleniyor):')\\n\",\n",
    "    \"resp = test_anamnez('Merve Aktaş, 28y, Female', 'Q1: Why here today? A1: Mild sore throat and runny nose for 3 days.')\\n\",\n",
    "    \"print(f'Model: {resp}')\"\n",
    "   ]\n",
