    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Fine-tuned modeli test et\\n\",\n",
    "    \"from unsloth import FastLanguageModel\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Inference modu\\n\",\n",
    "    \"FastLanguageModel.for_inference(model)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def test_anamnez(patient_info, history=''):\\n\",\n",
    "    \"    \\\"\\\"\\\"Fine-tuned modeli test et\\\"\\\"\\\"\\n\",\n",
    "    \"    user_content = f\\\"{SYSTEM_ANAMNEZ}\\\\n\\\\nPatient: {patient_info}\\\"\\n\",\n",
    "    \"    if history:\\n\",\n",
    "    \"        user_content += f\\\"\\\\nHistory: {history}\\\"\\n\",\n",
    "    \"    user_content += \\\"\\\\nAsk the next clinical question.\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    prompt = f\\\"<start_of_turn>user\\\\n{user_content}<end_of_turn>\\\\n<start_of_turn>model\\\\n\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    inputs = tokenizer(prompt, return_tensors='pt').to('cuda')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    outputs = model.generate(\\n\",\n",
    "    \"        **inputs,\\n\",\n",
    "    \"        max_new_tokens=200,\\n\",\n",
    "    \"        temperature=0.2,\\n\",\n",
    "    \"        top_p=0.85,\\n\",\n",
    "    \"        do_sample=True,\\n\",\n",
    "    \"        pad_token_id=tokenizer.eos_token_id\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    response = tokenizer.decode(outputs[0][inputs.input_ids.shape[1]:], skip_special_tokens=True)\\n\",\n",
    "    \"    return response.strip()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Test 1: Göğüs ağrısı (RED beklenen) ---\\n\",\n",
    "    \"print('TEST 1 — Göğüs Ağrısı (RED bekleniyor):')\\n\",\n",
    "    \"resp = test_anamnez('Ahmet Yilmaz, 58y, Male', 'Q1: Main complaint? A1: Chest pain and pressure since this morning, radiating to left arm.')\\n\",\n",
