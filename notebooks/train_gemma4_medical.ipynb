    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Backend'i güncelle — GEMMA_MODEL ortam değişkenini değiştir\\n\",\n",
    "    \"print(\\\"\\\"\\\"\\\\n=== BACKEND GÜNCELLEME ADIMI ===\\\\n\\n\",\n",
    "    \"1. mediscreen/docker-compose.yml içinde GEMMA_MODEL değiştir:\\n\",\n",
