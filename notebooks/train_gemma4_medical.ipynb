    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Triaj JSON testi\\n\",\n",
    "    \"import json\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('TEST 4 — Tam Mülakat Triaj JSON:')\\n\",\n",
    "    \"triage_prompt = \\\"\\\"\\\"Provide MTS triage assessment as valid JSON for:\\n\",\n",
    "    \"Patient: Ali Kara, 62y, Male.\\n\",\n",
    "    \"Q1: Main complaint? A1: Sudden left-sided weakness and speech difficulty for 30 minutes.\\n\",\n",
    "    \"Q2: Any headache? A2: Yes, severe.\\n\",\n",
    "    \"Q3: Vision changes? A3: Yes, blurred right side.\\n\",\n",
    "    \"Q4: History? A4: Hypertension, on aspirin.\\n\",\n",
    "    \"Q5: Last normal? A5: 45 minutes ago.\\n\",\n",
    "    \"Return ONLY JSON.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"user_content = f\\\"{SYSTEM_ANAMNEZ}\\\\n\\\\n{triage_prompt}\\\"\\n\",\n",
    "    \"prompt = f\\\"<start_of_turn>user\\\\n{user_content}<end_of_turn>\\\\n<start_of_turn>model\\\\n\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"inputs = tokenizer(prompt, return_tensors='pt').to('cuda')\\n\",\n",
    "    \"outputs = model.generate(**inputs, max_new_tokens=400, temperature=0.1,\\n\",\n",
    "    \"                          do_sample=True, pad_token_id=tokenizer.eos_token_id)\\n\",\n",
    "    \"response = tokenizer.decode(outputs[0][inputs.input_ids.shape[1]:], skip_special_tokens=True)\\n\",\n",
